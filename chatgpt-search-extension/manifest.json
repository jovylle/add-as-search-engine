{
  "manifest_version": 3,
  "name": "ChatGPT Search",
  "version": "1.4.3",
  "description": "Search ChatGPT from your address bar. Type c + Tab, your question. Optional auto-send. Won't change default search.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "omnibox": { "keyword": "c" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatGPT Search settings"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
